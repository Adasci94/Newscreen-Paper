{
  "version": 1,
  "description": "Weights used by ingest/score.py. Editing this file changes the ranking of the whole platform without touching any code — that is the point.",
  "source_score": {
    "formula": "reliability*w + technical_depth*w + editorial_quality*w + creator_score*w + max(primary, official_documentation, research, benchmark bonus) + specialization_bonus + community_penalty, capped at 100",
    "weights": {
      "reliability": 0.35,
      "technical_depth": 0.3,
      "editorial_quality": 0.25,
      "creator_score": 0.1
    },
    "primary_source_bonus": 12,
    "official_documentation_bonus": 8,
    "research_bonus": 8,
    "benchmark_bonus": 6,
    "specialization_bonus": 5,
    "community_penalty": -15,
    "note": "Popularity is deliberately not an input. A niche researcher blog outranks a high-traffic aggregator. Type bonuses do NOT stack: a source has one nature, so the largest applicable bonus is applied, never their sum.",
    "bonuses_are_exclusive": true
  },
  "article_score": {
    "formula": "overall = 0.30*importance + 0.22*credibility + 0.18*quality + 0.15*technical + 0.15*freshness - 0.20*hype",
    "weights": {
      "importance": 0.3,
      "credibility": 0.22,
      "quality": 0.18,
      "technical": 0.15,
      "freshness": 0.15,
      "hype_penalty": 0.2
    }
  },
  "freshness": {
    "half_life_hours": 30,
    "note": "Exponential decay. After ~30h an item keeps half of its freshness score; after 5 days it is nearly zero. Research and tutorials use a slower decay because they do not expire.",
    "slow_decay_content_types": [
      "research",
      "tutorial",
      "workflow",
      "curiosity",
      "documentation"
    ],
    "slow_decay_half_life_hours": 240
  },
  "importance_signals": {
    "event_coverage_multi_source": 14,
    "event_has_primary_source": 10,
    "official_release": 12,
    "major_company": 8,
    "benchmark_update": 6,
    "festival_or_awards": 8,
    "major_companies": [
      "OpenAI",
      "Anthropic",
      "Google DeepMind",
      "Google",
      "Meta",
      "NVIDIA",
      "Microsoft",
      "xAI",
      "Mistral",
      "Adobe",
      "Runway",
      "Midjourney",
      "Stability AI",
      "Black Forest Labs",
      "Luma AI",
      "ElevenLabs",
      "Apple",
      "Netflix",
      "Disney",
      "Warner Bros",
      "A24",
      "Blackmagic Design",
      "ARRI"
    ]
  },
  "hype_signals": {
    "note": "Lexical clickbait detection. Matching is case-insensitive and applied to the title only, so a body that legitimately discusses hype is not penalised.",
    "patterns_en": [
      "you won't believe",
      "shocking",
      "insane",
      "mind-blowing",
      "game changer",
      "game-changer",
      "changes everything",
      "the end of",
      "is dead",
      "nobody is talking about",
      "this will replace",
      "goes viral",
      "crazy",
      "secret trick",
      "hack you need",
      "must-see",
      "breaks the internet"
    ],
    "patterns_it": [
      "non crederai",
      "incredibile",
      "shock",
      "pazzesco",
      "cambia tutto",
      "la fine di",
      "è morto",
      "nessuno ne parla",
      "sostituirà",
      "virale",
      "trucco segreto",
      "da non perdere"
    ],
    "penalty_per_match": 22,
    "max_penalty": 70,
    "all_caps_title_penalty": 15,
    "excessive_punctuation_penalty": 10
  },
  "technical_signals": {
    "note": "Rewards depth. Presence of these terms in title or summary suggests substance rather than announcement churn.",
    "terms": [
      "benchmark",
      "architecture",
      "architettura",
      "inference",
      "latency",
      "quantization",
      "quantizzazione",
      "fine-tuning",
      "fine tuning",
      "embedding",
      "transformer",
      "diffusion",
      "attention",
      "throughput",
      "parameters",
      "parametri",
      "context window",
      "ablation",
      "paper",
      "open weights",
      "training",
      "dataset",
      "workflow",
      "pipeline",
      "codec",
      "bitrate",
      "color space",
      "log",
      "raw",
      "compositing",
      "rendering",
      "render",
      "node",
      "lut",
      "aces"
    ],
    "points_per_term": 7,
    "max_points": 55
  },
  "tutorial_signals": {
    "patterns_en": [
      "how to",
      "tutorial",
      "guide",
      "walkthrough",
      "step by step",
      "step-by-step",
      "getting started",
      "build a",
      "building a",
      "workflow",
      "explained",
      "crash course",
      "masterclass",
      "beginner",
      "learn how to",
      "learn to ",
      "a guide to"
    ],
    "patterns_it": [
      "come fare",
      "come usare",
      "come creare",
      "tutorial",
      "guida",
      "passo passo",
      "spiegato",
      "corso",
      "workflow",
      "per iniziare",
      "impara a ",
      "guida a "
    ]
  },
  "curiosity_signals": {
    "patterns_en": [
      "how does",
      "how do",
      "why does",
      "why do",
      "what happens when",
      "what is",
      "how is it built",
      "under the hood",
      "inside the",
      "the science of",
      "explained"
    ],
    "patterns_it": [
      "come funziona",
      "come funzionano",
      "perché",
      "perche",
      "cosa succede quando",
      "che cosa",
      "com'è fatto",
      "dietro le quinte",
      "la scienza di",
      "spiegazione"
    ]
  },
  "deduplication": {
    "url_strip_params": [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content",
      "utm_id",
      "fbclid",
      "gclid",
      "mc_cid",
      "mc_eid",
      "ref",
      "source",
      "cmpid",
      "sh",
      "amp",
      "s",
      "__twitter_impression",
      "guccounter",
      "guce_referrer",
      "guce_referrer_sig"
    ],
    "title_similarity_threshold": 0.82,
    "entity_overlap_min": 2,
    "cluster_window_hours": 72,
    "note": "Two items cluster into the same event when they are within the time window, share a category, come from DIFFERENT sources, and either their titles are similar above title_similarity_threshold, or they share at least entity_overlap_min named entities AND their titles still reach entity_title_min_similarity. The second condition stops unrelated stories that merely name the same big company from being merged.",
    "entity_title_min_similarity": 0.35
  },
  "home_layout": {
    "top_stories": 5,
    "per_macro_block": 4,
    "latest": 24,
    "min_overall_score_for_top": 45,
    "max_per_source_in_top": 2,
    "note": "max_per_source_in_top stops a single prolific publisher from owning the front page."
  },
  "translation": {
    "enabled": true,
    "targets": [
      "it",
      "en"
    ],
    "daily_word_budget": 0,
    "max_articles": 500,
    "translate_summaries": true,
    "note": "Titles and summaries are translated during ingest, highest-scoring articles first, into a permanent cache (data/translations.json) so nothing is ever paid for twice. Whatever the budget does not reach is translated on demand in the browser, so the reader always sees Italian when Italian is selected. Provider is chosen automatically: DEEPL_API_KEY or ANTHROPIC_API_KEY if present, otherwise MyMemory, which needs no key. Proper nouns are verified after translation and a result that lost them is discarded in favour of the original."
  }
}